  "role_roadmaps": {
    "backend_developer": {
      "steps": ["Python", "SQL", "REST APIs", "Git", "Linux", "Docker", "FastAPI", "PostgreSQL", "AWS"],
      "description": "Master backend fundamentals, then progressively move to containerization and cloud deployment."
    },
    "frontend_developer": {
      "steps": ["HTML", "CSS", "JavaScript", "Git", "React", "TypeScript", "REST APIs", "Testing", "Node.js"],
      "description": "Build solid web fundamentals, then learn modern frameworks and testing practices."
    },
    "fullstack_developer": {
      "steps": ["JavaScript", "HTML", "CSS", "Python", "SQL", "React", "Node.js", "REST APIs", "Git", "Docker", "PostgreSQL"],
      "description": "Develop frontend and backend skills in parallel, then integrate with containerization."
    },
    "data_scientist": {
      "steps": ["Python", "Statistics", "SQL", "NumPy", "Pandas", "Machine Learning", "Scikit-learn", "Data Visualization", "Jupyter", "TensorFlow"],
      "description": "Build strong mathematical foundations, then progress through Python data stack to ML frameworks."
    },
    "devops_engineer": {
      "steps": ["Linux", "Bash", "Git", "Python", "Docker", "Kubernetes", "CI/CD", "AWS", "Terraform", "Monitoring"],
      "description": "Start with OS fundamentals, containerization, then cloud and automation tools."
    },
    "database_administrator": {
      "steps": ["SQL", "Database Design", "PostgreSQL", "MySQL", "Performance Tuning", "Backup & Recovery", "Linux", "MongoDB", "Redis", "AWS"],
      "description": "Master SQL fundamentals and relational databases, then expand to NoSQL and cloud databases."
    },
    "infosec_engineer": {
      "steps": ["Networking", "Linux", "Python", "Cybersecurity", "Cryptography", "Firewalls", "Penetration Testing", "SIEM", "Docker", "AWS"],
      "description": "Build networking and OS fundamentals, then progress to offensive and defensive security tools."
    },
    "systems_analyst": {
      "steps": ["SQL", "Requirements Analysis", "System Design", "Python", "UML", "Agile", "REST APIs", "Data Analysis", "Testing", "Documentation"],
      "description": "Start with analysis fundamentals and SQL, then develop technical integration and project skills."
    }
  }
